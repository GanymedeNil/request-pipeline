{
  // Type-checks the extension's JavaScript through JSDoc; nothing is compiled.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["chrome"]
  },
  "include": ["background.js", "config.js", "popup.js", "lib/**/*.js"]
}
